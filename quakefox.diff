+float() FoxFindTarget =
+{
+	local entity client, fox_target, best;
+	local float bestdist, dist;
+
+	client = checkclient ();
+	if (!client)
+		return FALSE;
+	if (client.flags & FL_NOTARGET)
+		return FALSE;
+	if (client.items & IT_INVISIBILITY)
+		return FALSE;
+	if (!visible (client))
+		return FALSE;
+
+	fox_target = findradius (self.origin, 1000);
+	best = world;
+	bestdist = 999999;
+	while (fox_target)
+	{
+		if (fox_target != self && fox_target != client
+		&& (fox_target.flags & FL_MONSTER)
+		&& fox_target.health > 0
+		&& fox_target.classname != "monster_dog"
+		&& visible (fox_target))
+		{
+			dist = vlen (fox_target.origin - self.origin);
+			if (dist < bestdist)
+			{
+				best = fox_target;
+				bestdist = dist;
+			}
+		}
+		fox_target = fox_target.chain;
+	}
+
+	if (best)
+	{
+		self.enemy = best;
+		FoundTarget ();
+		return TRUE;
+	}
+
+	self.enemy = world;
+	self.goalentity = client;
+	self.think = self.th_run;
+	self.ideal_yaw = vectoyaw(client.origin - self.origin);
+	self.nextthink = time + 0.1;
+	return TRUE;
+};
+
